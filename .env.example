# Copy to .env (never committed) and fill in. Read by shared/config.py.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Set only once we have Jev's API docs wired into shared/decide.py; until then leave it empty.
JEV_API_KEY=
# Which LLM provider shared/llm.py calls: anthropic, groq, cerebras, ollama, or openai_compatible
# (with LLM_BASE_URL and LLM_API_KEY). All calls are cached and logged the same way whichever you pick.
LLM_PROVIDER=groq
# Free Groq key from console.groq.com -> API Keys (starts with gsk_). Paste it after the = sign, no quotes.
# Empty = the AI parts are off and everything runs on its offline rules. Never add a payment method.
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Optional overrides. Empty = the provider's defaults: groq openai/gpt-oss-20b (fast) / openai/gpt-oss-120b
# (smart); anthropic claude-haiku-4-5-20251001 / claude-sonnet-5-5. complete(model="fast"|"smart") resolves to these.
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# Seconds between calls (free tiers limit requests per minute); empty = the provider's default
LLM_MIN_INTERVAL_S=
# LLM disk cache (same input, same output, free reruns) and call log
LLM_CACHE_DIR=lake/llm_cache
# 1 = answer only from the cache and raise on a miss (tests, demo reruns)
LLM_OFFLINE=0
# Which database the app and layers 2-4 read: lake/maple.duckdb (full) or lake/dev.duckdb (sample)
DHANDHO_DB=lake/maple.duckdb
# Default user name written to audit.events
DHANDHO_USER=

# OpenRouter (used by Layer 2 when set; free models available). Key from openrouter.ai -> Keys; never commit .env
OPENROUTER_API_KEY=
L2_LLM_MODEL=qwen/qwen3.8-27b:free
L2_LLM_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
# Layer 2 guardrail: at most this many new LLM calls a day (cached answers don't count). 300 suits Groq's
# free plan (about 1,000 a day); use 45 with OpenRouter's free tier (about 50 a day)
L2_LLM_DAILY_CALLS=300
